//===========================================================================
//
//  Shadows over Brightwater
//
//  A cooperative RPG / strategy map for 1-4 players.
//  Pick a hero, build up your base, claim outposts for income and destroy
//  the Scourge citadel in the north while holding off its raids.
//
//  Map layout data (positions of camps, outposts, bases ...) is generated by
//  mapgen/script.py from mapgen/layout.py and spliced in at the two marker
//  lines below when the map is built (build.py).
//
//===========================================================================

globals
    // Players ---------------------------------------------------------------
    constant integer USERS                 = 4
    constant integer TOWN_ID               = 4
    constant integer SCOURGE_ID            = 5
    player array     userPlayer
    boolean array    playing
    integer          playerCount           = 0
    player           townPlayer            = null
    player           scourgePlayer         = null
    player           creepPlayer           = null
    player           passivePlayer         = null
    string array     playerColor

    // Unit tags (stored as unit custom value) -------------------------------
    constant integer TAG_CAMP              = 100
    constant integer TAG_BOSS              = 300
    constant integer TAG_BOSS_ESCORT       = 400
    constant integer TAG_RAID              = 500
    constant integer TAG_OUTPOST_TOWER     = 600
    constant integer TAG_OUTPOST_GUARD     = 700
    constant integer TAG_TOWN_GUARD        = 800

    // Layout data (filled by InitLayout) ------------------------------------
    real array       baseHallX
    real array       baseHallY
    real array       baseMineX
    real array       baseMineY
    integer          outpostCount          = 0
    real array       outpostX
    real array       outpostY
    string array     outpostName
    boolean array    outpostStartsScourge
    integer          campCount             = 0
    real array       campX
    real array       campY
    string array     campName
    boolean array    campRespawns
    integer array    campFirst
    integer array    campSize
    integer          campUnitCount         = 0
    integer array    campUnitType
    real array       campUnitX
    real array       campUnitY
    integer          bossCount             = 0
    real array       bossX
    real array       bossY
    string array     bossName
    integer array    bossFirst
    integer array    bossSize
    integer          bossUnitCount         = 0
    integer array    bossUnitType
    integer          townStructCount       = 0
    integer array    townStructType
    real array       townStructX
    real array       townStructY
    boolean array    townStructPassive
    integer          townGuardCount        = 0
    integer array    townGuardType
    real array       townGuardX
    real array       townGuardY
    integer          scourgeStructCount    = 0
    integer array    scourgeStructType
    real array       scourgeStructX
    real array       scourgeStructY
    integer          scourgeGuardCount     = 0
    integer array    scourgeGuardType
    real array       scourgeGuardX
    real array       scourgeGuardY
    real             castleX               = 0.0
    real             castleY               = 0.0
    real             rallyX                = 0.0
    real             rallyY                = 0.0
    real             raidX                 = 0.0
    real             raidY                 = 0.0
    real             lichX                 = 0.0
    real             lichY                 = 0.0

    // Game state ------------------------------------------------------------
    integer          gameSeconds           = 0
    boolean          gameOver              = false
    unit array       hero
    unit array       hall
    integer array    kills
    unit             castle                = null
    unit             citadel               = null
    unit             lich                  = null
    unit             armory                = null
    boolean          lichDead              = false
    boolean          citadelDead           = false
    group            townGuards            = null
    group            raiders               = null
    group            tempGroup             = null

    // Camps -----------------------------------------------------------------
    integer array    campAlive
    integer array    campRespawnAt

    // Outposts --------------------------------------------------------------
    // owner: -1 = nobody, 0..3 = a user player, SCOURGE_ID = the Scourge
    integer array    outpostOwner
    unit array       outpostTower
    boolean          frontierDone          = false

    // Raids -----------------------------------------------------------------
    timer            raidTimer             = null
    timerdialog      raidDialog            = null
    integer          raidWave              = 0
    integer          raidTargetCount       = 0
    real array       raidTargetX
    real array       raidTargetY
    integer array    raidTargetWeight
    string array     raidTargetName

    // Heroes ----------------------------------------------------------------
    constant integer HERO_CHOICES          = 10
    integer array    heroType
    string array     heroLabel
    dialog           heroDialog            = null
    button array     heroButton
    button           randomButton          = null
    timer array      reviveTimer
    timerdialog array reviveDialog

    // Quests ----------------------------------------------------------------
    quest            questMain             = null
    questitem        questLichItem         = null
    questitem        questCitadelItem      = null
    quest            questDefend           = null
    quest            questFrontier         = null
    questitem        questFrontierItem     = null
    quest            questBrood            = null
    quest            questUrn              = null
    questitem        questUrnKillItem      = null
    questitem        questUrnReturnItem    = null
    quest            questOgre             = null
    quest            questDragon           = null
    quest            questWolves           = null
    questitem        questWolvesItem       = null
    integer          wolvesKilled          = 0
    constant integer WOLVES_NEEDED         = 12
    boolean          urnReturned           = false
    boolean          urnDropped            = false

    // Interface -------------------------------------------------------------
    multiboard       board                 = null
    integer array    boardRow
endglobals

//#LAYOUT

//===========================================================================
// Utilities
//===========================================================================

function Msg takes player p, string s returns nothing
    call DisplayTimedTextToPlayer(p, 0, 0, 12.0, s)
endfunction

function MsgAll takes string s returns nothing
    local integer i = 0
    loop
        exitwhen i >= USERS
        if playing[i] then
            call DisplayTimedTextToPlayer(userPlayer[i], 0, 0, 12.0, s)
        endif
        set i = i + 1
    endloop
endfunction

function UserIndex takes player p returns integer
    local integer i = 0
    loop
        exitwhen i >= USERS
        if p == userPlayer[i] then
            return i
        endif
        set i = i + 1
    endloop
    return -1
endfunction

function IsAlive takes unit u returns boolean
    return u != null and GetWidgetLife(u) > 0.405
endfunction

function ColoredName takes integer i returns string
    return playerColor[i] + GetPlayerName(userPlayer[i]) + "|r"
endfunction

function FloatText takes player p, string s, real x, real y, integer r, integer g, integer b returns nothing
    local texttag t = CreateTextTag()
    call SetTextTagText(t, s, 0.023)
    call SetTextTagPos(t, x, y, 96.0)
    call SetTextTagColor(t, r, g, b, 255)
    call SetTextTagVelocity(t, 0.0, 0.03)
    call SetTextTagPermanent(t, false)
    call SetTextTagLifespan(t, 3.0)
    call SetTextTagFadepoint(t, 2.0)
    if p != null then
        call SetTextTagVisibility(t, GetLocalPlayer() == p)
    endif
    set t = null
endfunction

function AddGold takes integer i, integer gold, integer lumber returns nothing
    local player p = userPlayer[i]
    call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) + gold)
    call SetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER, GetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER) + lumber)
    set p = null
endfunction

function RewardAll takes integer gold, integer lumber returns nothing
    local integer i = 0
    loop
        exitwhen i >= USERS
        if playing[i] then
            call AddGold(i, gold, lumber)
        endif
        set i = i + 1
    endloop
endfunction

function DistanceXY takes real x1, real y1, real x2, real y2 returns real
    return SquareRoot((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1))
endfunction

function IsHostileOwner takes player p returns boolean
    return p == scourgePlayer or p == creepPlayer
endfunction

function TimeText takes integer seconds returns string
    local integer m = seconds / 60
    local integer s = seconds - m * 60
    if s < 10 then
        return I2S(m) + ":0" + I2S(s)
    endif
    return I2S(m) + ":" + I2S(s)
endfunction

function DropRandomItem takes itemtype kind, integer level, real x, real y returns nothing
    local integer id = ChooseRandomItemEx(kind, level)
    if id != 0 then
        call CreateItem(id, x, y)
    endif
endfunction

//===========================================================================
// Multiboard
//===========================================================================

function CountOutposts takes integer owner returns integer
    local integer o = 0
    local integer n = 0
    loop
        exitwhen o >= outpostCount
        if outpostOwner[o] == owner then
            set n = n + 1
        endif
        set o = o + 1
    endloop
    return n
endfunction

function SetBoardCell takes integer row, integer col, string s returns nothing
    local multiboarditem mbi = MultiboardGetItem(board, row, col)
    call MultiboardSetItemValue(mbi, s)
    call MultiboardReleaseItem(mbi)
    set mbi = null
endfunction

function UpdateBoard takes nothing returns nothing
    local integer i = 0
    local integer row
    local string lv
    local string raidText
    if board == null then
        return
    endif
    loop
        exitwhen i >= USERS
        set row = boardRow[i]
        if row > 0 then
            if hero[i] == null then
                set lv = "-"
            elseif IsAlive(hero[i]) then
                set lv = I2S(GetHeroLevel(hero[i]))
            else
                set lv = "|cff808080" + I2S(GetHeroLevel(hero[i])) + "|r"
            endif
            if not playing[i] then
                call SetBoardCell(row, 0, "|cff808080" + GetPlayerName(userPlayer[i]) + "|r")
            endif
            call SetBoardCell(row, 1, lv)
            call SetBoardCell(row, 2, I2S(kills[i]))
            call SetBoardCell(row, 3, I2S(CountOutposts(i)))
        endif
        set i = i + 1
    endloop
    if citadelDead then
        set raidText = "|cff40ff40Citadel destroyed|r"
    else
        set raidText = "Raid " + I2S(raidWave + 1) + " in " + TimeText(R2I(TimerGetRemaining(raidTimer)))
    endif
    call SetBoardCell(playerCount + 1, 0, "|cffb080ffThe Scourge|r")
    call SetBoardCell(playerCount + 1, 1, "")
    call SetBoardCell(playerCount + 1, 2, raidText)
    call SetBoardCell(playerCount + 1, 3, I2S(CountOutposts(SCOURGE_ID)))
endfunction

function CreateBoard takes nothing returns nothing
    local integer i = 0
    local integer row = 1
    local integer col
    local multiboarditem mbi
    if not citadelDead then
        set raidDialog = CreateTimerDialog(raidTimer)
        call TimerDialogSetTitle(raidDialog, "Scourge raid")
        call TimerDialogDisplay(raidDialog, true)
    endif
    set board = CreateMultiboard()
    call MultiboardSetRowCount(board, playerCount + 2)
    call MultiboardSetColumnCount(board, 4)
    call MultiboardSetTitleText(board, "Shadows over Brightwater")
    call MultiboardSetItemsStyle(board, true, false)
    set i = 0
    loop
        exitwhen i >= playerCount + 2
        set col = 0
        loop
            exitwhen col >= 4
            set mbi = MultiboardGetItem(board, i, col)
            if col == 0 then
                call MultiboardSetItemWidth(mbi, 0.10)
            elseif col == 2 then
                call MultiboardSetItemWidth(mbi, 0.09)
            else
                call MultiboardSetItemWidth(mbi, 0.04)
            endif
            call MultiboardReleaseItem(mbi)
            set col = col + 1
        endloop
        set i = i + 1
    endloop
    call SetBoardCell(0, 0, "|cffffcc00Player|r")
    call SetBoardCell(0, 1, "|cffffcc00Lv|r")
    call SetBoardCell(0, 2, "|cffffcc00Kills|r")
    call SetBoardCell(0, 3, "|cffffcc00Posts|r")
    set i = 0
    loop
        exitwhen i >= USERS
        if playing[i] then
            set boardRow[i] = row
            call SetBoardCell(row, 0, ColoredName(i))
            set row = row + 1
        else
            set boardRow[i] = 0
        endif
        set i = i + 1
    endloop
    call UpdateBoard()
    call MultiboardDisplay(board, true)
    set mbi = null
endfunction

//===========================================================================
// Quests
//===========================================================================

function CompleteQuest takes quest q, string message returns nothing
    call QuestSetCompleted(q, true)
    call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_COMPLETED, "|cffffcc00QUEST COMPLETED|r - " + message)
    call FlashQuestDialogButton()
endfunction

function MakeQuest takes boolean required, string title, string description, string icon returns quest
    local quest q = CreateQuest()
    call QuestSetTitle(q, title)
    call QuestSetDescription(q, description)
    call QuestSetIconPath(q, icon)
    call QuestSetRequired(q, required)
    call QuestSetDiscovered(q, true)
    call QuestSetCompleted(q, false)
    return q
endfunction

function AddQuestItem takes quest q, string text returns questitem
    local questitem qi = QuestCreateItem(q)
    call QuestItemSetDescription(qi, text)
    call QuestItemSetCompleted(qi, false)
    return qi
endfunction

function CreateQuests takes nothing returns nothing
    local questitem qi
    set questMain = MakeQuest(true, "The Lich of the North", "Kel'Thuzad has raised a Black Citadel in the blighted north. Grow strong, gather an army and destroy it. Its raids will grow bolder the longer it stands.", "ReplaceableTextures\\CommandButtons\\BTNLichVersion2.blp")
    set questLichItem = AddQuestItem(questMain, "Slay Kel'Thuzad")
    set questCitadelItem = AddQuestItem(questMain, "Destroy the Black Citadel")

    set questDefend = MakeQuest(true, "Brightwater Must Stand", "Brightwater Castle shelters the last free people of the vale. If it falls, all is lost. The Scourge sends a raid every few minutes against the castle, your town halls and the outposts you hold.", "ReplaceableTextures\\CommandButtons\\BTNCastle.blp")
    set qi = AddQuestItem(questDefend, "Brightwater Castle must survive")

    set questFrontier = MakeQuest(false, "Reclaim the Frontier", "Four outposts guard the roads of the vale: Crossroads, Westwatch, Eastmarch and Northgate. Clear their guards and bring a hero to an outpost to claim it. Every outpost you hold pays gold and lumber. Hold all four at once and Brightwater will send knights to every commander.", "ReplaceableTextures\\CommandButtons\\BTNGuardTower.blp")
    set questFrontierItem = AddQuestItem(questFrontier, "Hold all four outposts at the same time")

    set questBrood = MakeQuest(false, "The Brood Mother", "A monstrous spider nests in the far west of the Darkwood and her brood is spreading. Kill her.", "ReplaceableTextures\\CommandButtons\\BTNSpiderBlue.blp")
    set qi = AddQuestItem(questBrood, "Slay the Brood Mother (west)")

    set questUrn = MakeQuest(false, "The Stolen Urn", "The Bandit Lord of the eastern woods has stolen the Urn of King Terenas from Brightwater's chapel. Take it back and return it to the castle.", "ReplaceableTextures\\CommandButtons\\BTNUrnOfKelThuzad.blp")
    set questUrnKillItem = AddQuestItem(questUrn, "Slay the Bandit Lord (east)")
    set questUrnReturnItem = AddQuestItem(questUrn, "Bring the Urn to Brightwater Castle")

    set questOgre = MakeQuest(false, "The Ogre Lord", "An ogre warlord has taken the north-eastern hills and raids the trade roads. End his reign.", "ReplaceableTextures\\CommandButtons\\BTNOgreLord.blp")
    set qi = AddQuestItem(questOgre, "Slay the Ogre Lord (north-east)")

    set questDragon = MakeQuest(false, "Wings of Flame", "A red dragon roosts among the north-western crags. Only the mightiest heroes should challenge it.", "ReplaceableTextures\\CommandButtons\\BTNRedDragon.blp")
    set qi = AddQuestItem(questDragon, "Slay the Red Dragon (north-west)")

    set questWolves = MakeQuest(false, "Wolf Pelts", "The vale's wolves have grown bold. The furriers of Brightwater pay well for pelts.", "ReplaceableTextures\\CommandButtons\\BTNTimberWolf.blp")
    set questWolvesItem = AddQuestItem(questWolves, "Wolves slain: 0/" + I2S(WOLVES_NEEDED))
    set qi = null
endfunction

function CheckVictory takes nothing returns nothing
    local integer i = 0
    if gameOver or not (lichDead and citadelDead) then
        return
    endif
    set gameOver = true
    call CompleteQuest(questMain, "The Lich of the North")
    call QuestSetCompleted(questDefend, true)
    call MsgAll("|cff40ff40The Black Citadel has fallen and Kel'Thuzad is no more. The vale is free!|r")
    loop
        exitwhen i >= USERS
        if playing[i] then
            call CustomVictoryBJ(userPlayer[i], true, true)
        endif
        set i = i + 1
    endloop
endfunction

function Defeat takes nothing returns nothing
    local integer i = 0
    if gameOver then
        return
    endif
    set gameOver = true
    call QuestSetFailed(questDefend, true)
    loop
        exitwhen i >= USERS
        if playing[i] then
            call CustomDefeatBJ(userPlayer[i], "Brightwater Castle has fallen to the Scourge.")
        endif
        set i = i + 1
    endloop
endfunction

//===========================================================================
// Creep camps and bosses
//===========================================================================

function SpawnCamp takes integer c returns nothing
    local integer k = campFirst[c]
    local integer last = campFirst[c] + campSize[c]
    local unit u
    set campAlive[c] = 0
    loop
        exitwhen k >= last
        set u = CreateUnit(creepPlayer, campUnitType[k], campUnitX[k], campUnitY[k], GetRandomReal(0.0, 360.0))
        call SetUnitUserData(u, TAG_CAMP + c)
        set campAlive[c] = campAlive[c] + 1
        set k = k + 1
    endloop
    set campRespawnAt[c] = 0
    set u = null
endfunction

function SpawnBoss takes integer b returns nothing
    local integer k = bossFirst[b]
    local integer last = bossFirst[b] + bossSize[b]
    local real a
    local unit u
    set u = CreateUnit(creepPlayer, bossUnitType[k], bossX[b], bossY[b], 270.0)
    call SetUnitUserData(u, TAG_BOSS + b)
    set k = k + 1
    loop
        exitwhen k >= last
        set a = 6.2832 * I2R(k - bossFirst[b]) / I2R(bossSize[b] - 1)
        set u = CreateUnit(creepPlayer, bossUnitType[k], bossX[b] + 220.0 * Cos(a), bossY[b] + 220.0 * Sin(a), 270.0)
        call SetUnitUserData(u, TAG_BOSS_ESCORT + b)
        set k = k + 1
    endloop
    set u = null
endfunction

function AnyUserUnitNear takes real x, real y, real radius returns boolean
    local unit u
    local boolean found = false
    call GroupEnumUnitsInRange(tempGroup, x, y, radius, null)
    loop
        set u = FirstOfGroup(tempGroup)
        exitwhen u == null
        call GroupRemoveUnit(tempGroup, u)
        if not found and IsAlive(u) and UserIndex(GetOwningPlayer(u)) >= 0 then
            set found = true
        endif
    endloop
    return found
endfunction

function CheckCampRespawns takes nothing returns nothing
    local integer c = 0
    loop
        exitwhen c >= campCount
        if campRespawnAt[c] > 0 and gameSeconds >= campRespawnAt[c] then
            if AnyUserUnitNear(campX[c], campY[c], 1400.0) then
                set campRespawnAt[c] = gameSeconds + 20
            else
                call SpawnCamp(c)
            endif
        endif
        set c = c + 1
    endloop
endfunction

//===========================================================================
// Outposts
//===========================================================================

function SetOutpostOwner takes integer o, integer owner returns nothing
    local unit u
    local integer k = 0
    set outpostOwner[o] = owner
    set outpostTower[o] = null
    if owner >= 0 and owner < USERS then
        set u = CreateUnit(userPlayer[owner], 'hgtw', outpostX[o], outpostY[o], 270.0)
        call SetUnitUserData(u, TAG_OUTPOST_TOWER + o)
        set outpostTower[o] = u
        call MsgAll(ColoredName(owner) + " has claimed |cffffcc00" + outpostName[o] + "|r.")
        call PingMinimap(outpostX[o], outpostY[o], 3.0)
    elseif owner == SCOURGE_ID then
        set u = CreateUnit(scourgePlayer, 'uzg1', outpostX[o], outpostY[o], 270.0)
        call SetUnitUserData(u, TAG_OUTPOST_TOWER + o)
        set outpostTower[o] = u
        loop
            exitwhen k >= 3
            set u = CreateUnit(scourgePlayer, 'ugho', outpostX[o] + GetRandomReal(-250.0, 250.0), outpostY[o] + GetRandomReal(-250.0, 250.0), 270.0)
            call SetUnitUserData(u, TAG_OUTPOST_GUARD + o)
            set k = k + 1
        endloop
        if gameSeconds > 5 then
            call MsgAll("|cffb080ffThe Scourge has seized " + outpostName[o] + "!|r Its raids will grow stronger.")
            call PingMinimap(outpostX[o], outpostY[o], 3.0)
        endif
    endif
    set u = null
endfunction

function CheckFrontierQuest takes nothing returns nothing
    local integer o = 0
    local integer i = 0
    local unit u
    if frontierDone then
        return
    endif
    loop
        exitwhen o >= outpostCount
        if outpostOwner[o] < 0 or outpostOwner[o] >= USERS then
            return
        endif
        set o = o + 1
    endloop
    set frontierDone = true
    call QuestItemSetCompleted(questFrontierItem, true)
    call CompleteQuest(questFrontier, "Reclaim the Frontier. Brightwater sends knights to every commander!")
    loop
        exitwhen i >= USERS
        if playing[i] then
            call AddGold(i, 300, 150)
            set u = CreateUnit(userPlayer[i], 'hkni', rallyX - 128.0, rallyY, 90.0)
            set u = CreateUnit(userPlayer[i], 'hkni', rallyX + 128.0, rallyY, 90.0)
        endif
        set i = i + 1
    endloop
    set u = null
endfunction

function CheckOutposts takes nothing returns nothing
    local integer o = 0
    local unit u
    local integer hostiles
    local integer scourgeNear
    local integer usersNear
    local integer claimant
    local integer owner
    local real d
    loop
        exitwhen o >= outpostCount
        if not IsAlive(outpostTower[o]) then
            set hostiles = 0
            set scourgeNear = 0
            set usersNear = 0
            set claimant = -1
            call GroupEnumUnitsInRange(tempGroup, outpostX[o], outpostY[o], 800.0, null)
            loop
                set u = FirstOfGroup(tempGroup)
                exitwhen u == null
                call GroupRemoveUnit(tempGroup, u)
                if IsAlive(u) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                    set d = DistanceXY(GetUnitX(u), GetUnitY(u), outpostX[o], outpostY[o])
                    set owner = UserIndex(GetOwningPlayer(u))
                    if owner >= 0 then
                        set usersNear = usersNear + 1
                        if claimant < 0 and d <= 450.0 and IsUnitType(u, UNIT_TYPE_HERO) then
                            set claimant = owner
                        endif
                    elseif IsHostileOwner(GetOwningPlayer(u)) then
                        set hostiles = hostiles + 1
                        if GetOwningPlayer(u) == scourgePlayer and d <= 450.0 then
                            set scourgeNear = scourgeNear + 1
                        endif
                    endif
                endif
            endloop
            if claimant >= 0 and hostiles == 0 then
                call SetOutpostOwner(o, claimant)
                call CheckFrontierQuest()
            elseif scourgeNear > 0 and usersNear == 0 and not citadelDead then
                call SetOutpostOwner(o, SCOURGE_ID)
            endif
        endif
        set o = o + 1
    endloop
    set u = null
endfunction

function PayOutpostIncome takes nothing returns nothing
    local integer o = 0
    local integer owner
    loop
        exitwhen o >= outpostCount
        set owner = outpostOwner[o]
        if owner >= 0 and owner < USERS and IsAlive(outpostTower[o]) then
            call AddGold(owner, 15, 5)
            call FloatText(userPlayer[owner], "+15 gold", outpostX[o], outpostY[o], 255, 220, 0)
        endif
        set o = o + 1
    endloop
endfunction

//===========================================================================
// Scourge raids
//===========================================================================

function AddRaidTarget takes real x, real y, integer weight, string name returns nothing
    set raidTargetX[raidTargetCount] = x
    set raidTargetY[raidTargetCount] = y
    set raidTargetWeight[raidTargetCount] = weight
    set raidTargetName[raidTargetCount] = name
    set raidTargetCount = raidTargetCount + 1
endfunction

function PickRaidTarget takes nothing returns integer
    local integer i = 0
    local integer total = 0
    local integer roll
    set raidTargetCount = 0
    if IsAlive(castle) then
        call AddRaidTarget(castleX, castleY, 3 + raidWave / 4, "Brightwater Castle")
    endif
    loop
        exitwhen i >= outpostCount
        if outpostOwner[i] >= 0 and outpostOwner[i] < USERS and IsAlive(outpostTower[i]) then
            call AddRaidTarget(outpostX[i], outpostY[i], 3, outpostName[i])
        endif
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen i >= USERS
        if playing[i] and IsAlive(hall[i]) then
            call AddRaidTarget(baseHallX[i], baseHallY[i], 2, "the base of " + ColoredName(i))
        endif
        set i = i + 1
    endloop
    if raidTargetCount == 0 then
        call AddRaidTarget(castleX, castleY, 1, "Brightwater")
    endif
    set i = 0
    loop
        exitwhen i >= raidTargetCount
        set total = total + raidTargetWeight[i]
        set i = i + 1
    endloop
    set roll = GetRandomInt(1, total)
    set i = 0
    loop
        set roll = roll - raidTargetWeight[i]
        exitwhen roll <= 0 or i >= raidTargetCount - 1
        set i = i + 1
    endloop
    return i
endfunction

function RaidUnitCost takes integer id returns integer
    if id == 'ugho' then
        return 2
    elseif id == 'ucry' then
        return 3
    elseif id == 'unec' then
        return 2
    elseif id == 'ugar' then
        return 3
    elseif id == 'uabo' then
        return 4
    elseif id == 'uban' then
        return 2
    elseif id == 'umtw' then
        return 4
    elseif id == 'ufro' then
        return 8
    endif
    return 1
endfunction

function PickRaidUnit takes nothing returns integer
    local integer r = GetRandomInt(1, 100)
    if raidWave >= 10 and r <= 6 then
        return 'ufro'
    elseif raidWave >= 7 and r <= 14 then
        return 'umtw'
    elseif raidWave >= 5 and r <= 28 then
        return 'uabo'
    elseif raidWave >= 6 and r <= 38 then
        return 'uban'
    elseif raidWave >= 4 and r <= 48 then
        return 'ugar'
    elseif raidWave >= 3 and r <= 58 then
        return 'unec'
    elseif raidWave >= 2 and r <= 75 then
        return 'ucry'
    endif
    return 'ugho'
endfunction

function ApplyScourgeUpgrades takes nothing returns nothing
    local integer lv = raidWave / 4
    if lv > 3 then
        set lv = 3
    endif
    if lv > 0 then
        call SetPlayerTechResearched(scourgePlayer, 'Rume', lv)
        call SetPlayerTechResearched(scourgePlayer, 'Ruar', lv)
        call SetPlayerTechResearched(scourgePlayer, 'Rura', lv)
        call SetPlayerTechResearched(scourgePlayer, 'Rucr', lv)
    endif
    if raidWave >= 6 then
        call SetPlayerTechResearched(scourgePlayer, 'Rugf', 1)
        call SetPlayerTechResearched(scourgePlayer, 'Rune', 1)
        call SetPlayerTechResearched(scourgePlayer, 'Ruba', 1)
    endif
    if raidWave >= 12 then
        call SetPlayerTechResearched(scourgePlayer, 'Rune', 2)
        call SetPlayerTechResearched(scourgePlayer, 'Ruba', 2)
    endif
endfunction

function RandomScourgeOutpost takes nothing returns integer
    local integer o = 0
    local integer n = 0
    local integer pick = -1
    loop
        exitwhen o >= outpostCount
        if outpostOwner[o] == SCOURGE_ID and IsAlive(outpostTower[o]) then
            set n = n + 1
            if GetRandomInt(1, n) == 1 then
                set pick = o
            endif
        endif
        set o = o + 1
    endloop
    return pick
endfunction

function OrderRaider takes unit u, real x, real y returns nothing
    call RemoveGuardPosition(u)
    call IssuePointOrder(u, "attack", x, y)
endfunction

function LaunchRaid takes nothing returns nothing
    local integer budget
    local integer id
    local integer n = 0
    local integer t
    local integer o
    local real sx
    local real sy
    local real interval
    local unit u
    if gameOver or citadelDead then
        return
    endif
    set raidWave = raidWave + 1
    call ApplyScourgeUpgrades()
    set budget = 3 + 3 * raidWave + 2 * (playerCount - 1) + 2 * CountOutposts(SCOURGE_ID)
    set t = PickRaidTarget()
    loop
        exitwhen budget < 1 or n >= 30
        set id = PickRaidUnit()
        set budget = budget - RaidUnitCost(id)
        // half of the warriors march from the citadel, the rest from
        // outposts the Scourge holds
        set sx = raidX
        set sy = raidY
        set o = -1
        if GetRandomInt(0, 1) == 0 then
            set o = RandomScourgeOutpost()
        endif
        if o >= 0 then
            set sx = outpostX[o]
            set sy = outpostY[o] + 300.0
        endif
        set u = CreateUnit(scourgePlayer, id, sx + GetRandomReal(-300.0, 300.0), sy + GetRandomReal(-200.0, 200.0), 270.0)
        call SetUnitUserData(u, TAG_RAID)
        call GroupAddUnit(raiders, u)
        if id == 'unec' then
            call IssueImmediateOrder(u, "raisedeadon")
        elseif id == 'uban' then
            call IssueImmediateOrder(u, "curseon")
        endif
        call OrderRaider(u, raidTargetX[t], raidTargetY[t])
        set n = n + 1
    endloop
    call MsgAll("|cffb080ffRaid " + I2S(raidWave) + ":|r " + I2S(n) + " Scourge warriors march on " + raidTargetName[t] + "!")
    call PingMinimap(raidTargetX[t], raidTargetY[t], 4.0)
    call PingMinimap(raidX, raidY, 4.0)
    set interval = 150.0 - 4.0 * I2R(raidWave)
    if interval < 85.0 then
        set interval = 85.0
    endif
    call TimerStart(raidTimer, interval, false, function LaunchRaid)
    set u = null
endfunction

function NearestRaidTarget takes real x, real y returns integer
    local integer i = 0
    local integer best = 0
    local real bestD = 1000000.0
    local real d
    loop
        exitwhen i >= raidTargetCount
        set d = DistanceXY(x, y, raidTargetX[i], raidTargetY[i])
        if d < bestD then
            set bestD = d
            set best = i
        endif
        set i = i + 1
    endloop
    return best
endfunction

function RetargetIdleRaiders takes nothing returns nothing
    local group g = CreateGroup()
    local unit u
    local integer t
    if raidWave == 0 then
        call DestroyGroup(g)
        set g = null
        return
    endif
    call PickRaidTarget()
    loop
        set u = FirstOfGroup(raiders)
        exitwhen u == null
        call GroupRemoveUnit(raiders, u)
        if IsAlive(u) then
            call GroupAddUnit(g, u)
            if GetUnitCurrentOrder(u) == 0 then
                set t = NearestRaidTarget(GetUnitX(u), GetUnitY(u))
                call OrderRaider(u, raidTargetX[t], raidTargetY[t])
            endif
        endif
    endloop
    call DestroyGroup(raiders)
    set raiders = g
    set g = null
    set u = null
endfunction

//===========================================================================
// Brightwater
//===========================================================================

function CountTownGuards takes nothing returns integer
    local group g = CreateGroup()
    local unit u
    local integer n = 0
    loop
        set u = FirstOfGroup(townGuards)
        exitwhen u == null
        call GroupRemoveUnit(townGuards, u)
        if IsAlive(u) then
            call GroupAddUnit(g, u)
            set n = n + 1
        endif
    endloop
    call DestroyGroup(townGuards)
    set townGuards = g
    set g = null
    return n
endfunction

function ReinforceTown takes nothing returns nothing
    local unit u
    local integer k = 0
    if gameOver or not IsAlive(castle) then
        return
    endif
    if CountTownGuards() >= 8 then
        return
    endif
    loop
        exitwhen k >= 2
        if raidWave >= 8 and k == 1 then
            set u = CreateUnit(townPlayer, 'hkni', castleX + 300.0, castleY + 300.0, 90.0)
        else
            set u = CreateUnit(townPlayer, 'hfoo', castleX - 300.0 + 600.0 * I2R(k), castleY + 300.0, 90.0)
        endif
        call SetUnitUserData(u, TAG_TOWN_GUARD)
        call GroupAddUnit(townGuards, u)
        call IssuePointOrder(u, "attack", rallyX + GetRandomReal(-200.0, 200.0), rallyY)
        set k = k + 1
    endloop
    set u = null
endfunction

function CheckUrnDelivery takes nothing returns nothing
    local integer i = 0
    local item it
    if urnReturned or not urnDropped then
        return
    endif
    loop
        exitwhen i >= USERS
        if IsAlive(hero[i]) and UnitHasItemOfTypeBJ(hero[i], 'ktrm') then
            if DistanceXY(GetUnitX(hero[i]), GetUnitY(hero[i]), castleX, castleY) < 700.0 then
                set urnReturned = true
                set it = GetItemOfTypeFromUnitBJ(hero[i], 'ktrm')
                call RemoveItem(it)
                call QuestItemSetCompleted(questUrnReturnItem, true)
                call CompleteQuest(questUrn, "The Stolen Urn. Every commander receives 250 gold; " + ColoredName(i) + " receives a Tome of Experience.")
                call RewardAll(250, 0)
                call CreateItem('texp', GetUnitX(hero[i]), GetUnitY(hero[i]))
                set it = null
                return
            endif
        endif
        set i = i + 1
    endloop
    set it = null
endfunction

//===========================================================================
// Heroes
//===========================================================================

function HeroSpawnX takes integer i returns real
    if IsAlive(hall[i]) then
        return baseHallX[i]
    endif
    return castleX
endfunction

function HeroSpawnY takes integer i returns real
    if IsAlive(hall[i]) then
        return baseHallY[i] + 384.0
    endif
    return castleY + 512.0
endfunction

function GiveHero takes integer i, integer choice returns nothing
    local real x = HeroSpawnX(i)
    local real y = HeroSpawnY(i)
    if hero[i] != null then
        return
    endif
    set hero[i] = CreateUnit(userPlayer[i], heroType[choice], x, y, 270.0)
    call UnitAddItemById(hero[i], 'phea')
    call UnitAddItemById(hero[i], 'pman')
    call UnitAddItemById(hero[i], 'stwp')
    call SelectUnitForPlayerSingle(hero[i], userPlayer[i])
    call PanCameraToTimedForPlayer(userPlayer[i], x, y, 0.5)
    if heroDialog != null then
        call DialogDisplay(userPlayer[i], heroDialog, false)
    endif
    call MsgAll(ColoredName(i) + " rides out as the |cffffcc00" + heroLabel[choice] + "|r.")
    call UpdateBoard()
endfunction

function OnHeroButton takes nothing returns nothing
    local integer i = UserIndex(GetTriggerPlayer())
    local button b = GetClickedButton()
    local integer c = 0
    if i < 0 then
        set b = null
        return
    endif
    if b == randomButton then
        call GiveHero(i, GetRandomInt(0, HERO_CHOICES - 1))
        call AddGold(i, 150, 0)
        call Msg(userPlayer[i], "|cffffcc00+150 gold|r for trusting fate.")
    else
        loop
            exitwhen c >= HERO_CHOICES
            if b == heroButton[c] then
                call GiveHero(i, c)
            endif
            set c = c + 1
        endloop
    endif
    set b = null
endfunction

function InitHeroChoices takes nothing returns nothing
    // 'H000' is the map's own hero: see mapgen/hero.py and mapgen/dwarf.py
    set heroType[0] = 'H000'
    set heroLabel[0] = "Dark Iron Thane"
    set heroType[1] = 'Hpal'
    set heroLabel[1] = "Paladin"
    set heroType[2] = 'Hamg'
    set heroLabel[2] = "Archmage"
    set heroType[3] = 'Hmkg'
    set heroLabel[3] = "Mountain King"
    set heroType[4] = 'Obla'
    set heroLabel[4] = "Blademaster"
    set heroType[5] = 'Ofar'
    set heroLabel[5] = "Far Seer"
    set heroType[6] = 'Otch'
    set heroLabel[6] = "Tauren Chieftain"
    set heroType[7] = 'Edem'
    set heroLabel[7] = "Demon Hunter"
    set heroType[8] = 'Emoo'
    set heroLabel[8] = "Priestess of the Moon"
    set heroType[9] = 'Npbm'
    set heroLabel[9] = "Pandaren Brewmaster"
endfunction

// Dialogs (and their buttons) do not work if they are created during map
// initialization: in single player the game then pauses on an empty dialog
// and never resumes. This runs from a timer once the game has started.
function CreateHeroDialog takes nothing returns nothing
    local trigger t = CreateTrigger()
    local integer c = 0
    set heroDialog = DialogCreate()
    call DialogSetMessage(heroDialog, "Choose your hero")
    loop
        exitwhen c >= HERO_CHOICES
        set heroButton[c] = DialogAddButton(heroDialog, heroLabel[c], 0)
        set c = c + 1
    endloop
    set randomButton = DialogAddButton(heroDialog, "Random (+150 gold)", 0)
    call TriggerRegisterDialogEvent(t, heroDialog)
    call TriggerAddAction(t, function OnHeroButton)
    set t = null
endfunction

function ShowHeroDialog takes nothing returns nothing
    local integer i = 0
    if heroDialog == null then
        call CreateHeroDialog()
    endif
    loop
        exitwhen i >= USERS
        if playing[i] and hero[i] == null then
            call DialogDisplay(userPlayer[i], heroDialog, true)
        endif
        set i = i + 1
    endloop
endfunction

function ForceHeroPick takes nothing returns nothing
    local integer i = 0
    loop
        exitwhen i >= USERS
        if playing[i] and hero[i] == null then
            call GiveHero(i, GetRandomInt(0, HERO_CHOICES - 1))
        endif
        set i = i + 1
    endloop
endfunction

function OnReviveTimer takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer i = 0
    loop
        exitwhen i >= USERS
        if t == reviveTimer[i] then
            if hero[i] != null and not IsAlive(hero[i]) and not gameOver then
                call ReviveHero(hero[i], HeroSpawnX(i), HeroSpawnY(i), true)
                call SelectUnitForPlayerSingle(hero[i], userPlayer[i])
                call PanCameraToTimedForPlayer(userPlayer[i], GetUnitX(hero[i]), GetUnitY(hero[i]), 0.5)
            endif
            call TimerDialogDisplay(reviveDialog[i], false)
        endif
        set i = i + 1
    endloop
    set t = null
endfunction

function StartRevive takes integer i returns nothing
    local real delay = 10.0 + 3.0 * I2R(GetHeroLevel(hero[i]))
    if reviveTimer[i] == null then
        set reviveTimer[i] = CreateTimer()
        set reviveDialog[i] = CreateTimerDialog(reviveTimer[i])
        call TimerDialogSetTitle(reviveDialog[i], "Hero revives in")
    endif
    call TimerStart(reviveTimer[i], delay, false, function OnReviveTimer)
    call TimerDialogDisplay(reviveDialog[i], false)
    if GetLocalPlayer() == userPlayer[i] then
        call TimerDialogDisplay(reviveDialog[i], true)
    endif
    call Msg(userPlayer[i], "Your hero has fallen and will return in " + I2S(R2I(delay)) + " seconds.")
endfunction

//===========================================================================
// Kills: loot, experience, quests
//===========================================================================

function GiveCreepExperience takes unit dead returns nothing
    local integer level = GetUnitLevel(dead)
    local integer xp = 15 + 12 * level
    local integer n = 0
    local integer k = 0
    local unit u
    local unit array found
    call GroupEnumUnitsInRange(tempGroup, GetUnitX(dead), GetUnitY(dead), 1200.0, null)
    loop
        set u = FirstOfGroup(tempGroup)
        exitwhen u == null
        call GroupRemoveUnit(tempGroup, u)
        if IsAlive(u) and IsUnitType(u, UNIT_TYPE_HERO) and UserIndex(GetOwningPlayer(u)) >= 0 and n < 8 then
            if GetHeroLevel(u) >= 5 then
                set found[n] = u
                set n = n + 1
            endif
        endif
    endloop
    loop
        exitwhen k >= n
        call AddHeroXP(found[k], xp / n, true)
        set found[k] = null
        set k = k + 1
    endloop
    set u = null
endfunction

function DropCreepLoot takes unit dead returns nothing
    local integer level = GetUnitLevel(dead)
    local integer roll = GetRandomInt(1, 100)
    local real x = GetUnitX(dead)
    local real y = GetUnitY(dead)
    local integer pl
    if roll > 8 + 2 * level then
        return
    endif
    set roll = GetRandomInt(1, 100)
    if roll <= 45 then
        set pl = (level + 2) / 2
        if pl < 2 then
            set pl = 2
        elseif pl > 6 then
            set pl = 6
        endif
        call DropRandomItem(ITEM_TYPE_CHARGED, pl, x, y)
    elseif roll <= 88 then
        set pl = (level + 1) / 2
        if pl < 1 then
            set pl = 1
        elseif pl > 6 then
            set pl = 6
        endif
        call DropRandomItem(ITEM_TYPE_PERMANENT, pl, x, y)
    else
        call DropRandomItem(ITEM_TYPE_POWERUP, GetRandomInt(1, 2), x, y)
    endif
endfunction

function OnBossDeath takes integer b, unit dead returns nothing
    local real x = GetUnitX(dead)
    local real y = GetUnitY(dead)
    call MsgAll("|cffffcc00" + bossName[b] + " has been slain!|r")
    if b == 0 then
        call DropRandomItem(ITEM_TYPE_PERMANENT, 5, x, y)
        call CompleteQuest(questBrood, "The Brood Mother. Every commander receives 200 gold.")
        call RewardAll(200, 0)
    elseif b == 1 then
        call DropRandomItem(ITEM_TYPE_PERMANENT, 4, x, y)
        call CreateItem('ktrm', x + 64.0, y)
        set urnDropped = true
        call QuestItemSetCompleted(questUrnKillItem, true)
        call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "|cffffcc00The Stolen Urn|r - The Urn of King Terenas lies on the ground. Bring it to Brightwater Castle.")
    elseif b == 2 then
        call DropRandomItem(ITEM_TYPE_PERMANENT, 6, x, y)
        call DropRandomItem(ITEM_TYPE_CHARGED, 4, x + 64.0, y)
        call CompleteQuest(questOgre, "The Ogre Lord. Every commander receives 300 gold.")
        call RewardAll(300, 0)
    elseif b == 3 then
        call DropRandomItem(ITEM_TYPE_ARTIFACT, 7, x, y)
        call DropRandomItem(ITEM_TYPE_PERMANENT, 6, x + 64.0, y)
        call CompleteQuest(questDragon, "Wings of Flame. Every commander receives 400 gold.")
        call RewardAll(400, 100)
    endif
endfunction

function CountWolf takes integer id returns nothing
    if wolvesKilled >= WOLVES_NEEDED then
        return
    endif
    if id == 'nwlt' or id == 'nwlg' or id == 'nwld' then
        set wolvesKilled = wolvesKilled + 1
        call QuestItemSetDescription(questWolvesItem, "Wolves slain: " + I2S(wolvesKilled) + "/" + I2S(WOLVES_NEEDED))
        if wolvesKilled >= WOLVES_NEEDED then
            call QuestItemSetCompleted(questWolvesItem, true)
            call CompleteQuest(questWolves, "Wolf Pelts. Every commander receives 150 gold and 75 lumber.")
            call RewardAll(150, 75)
        else
            call QuestMessageBJ(GetPlayersAll(), bj_QUESTMESSAGE_UPDATED, "|cffffcc00Wolf Pelts|r - " + I2S(wolvesKilled) + "/" + I2S(WOLVES_NEEDED))
        endif
    endif
endfunction

function OnUnitDeath takes nothing returns nothing
    local unit dead = GetTriggerUnit()
    local unit killer = GetKillingUnit()
    local player owner = GetOwningPlayer(dead)
    local integer tag = GetUnitUserData(dead)
    local integer ki = -1
    local integer oi = UserIndex(owner)
    local integer c
    if killer != null then
        set ki = UserIndex(GetOwningPlayer(killer))
    endif
    if ki >= 0 and IsHostileOwner(owner) then
        set kills[ki] = kills[ki] + 1
    endif

    // user heroes come back after a while
    if oi >= 0 and dead == hero[oi] then
        call StartRevive(oi)
    endif
    if oi >= 0 and dead == hall[oi] then
        call MsgAll("The town hall of " + ColoredName(oi) + " has been destroyed!")
    endif

    // outpost towers
    if tag >= TAG_OUTPOST_TOWER and tag < TAG_OUTPOST_TOWER + 100 then
        set c = tag - TAG_OUTPOST_TOWER
        if dead == outpostTower[c] then
            if outpostOwner[c] == SCOURGE_ID then
                call MsgAll("The Scourge tower at |cffffcc00" + outpostName[c] + "|r has fallen. Bring a hero there to claim the outpost!")
            else
                call MsgAll("|cffff4040" + outpostName[c] + " has been overrun!|r")
            endif
            set outpostOwner[c] = -1
            set outpostTower[c] = null
            call PingMinimap(outpostX[c], outpostY[c], 3.0)
        endif
    endif

    if owner == creepPlayer then
        if tag >= TAG_CAMP and tag < TAG_CAMP + 100 then
            set c = tag - TAG_CAMP
            set campAlive[c] = campAlive[c] - 1
            if campAlive[c] <= 0 and campRespawns[c] then
                set campRespawnAt[c] = gameSeconds + 210
            endif
        endif
        if ki >= 0 then
            call CountWolf(GetUnitTypeId(dead))
            call GiveCreepExperience(dead)
            if tag >= TAG_CAMP and tag < TAG_CAMP + 100 then
                call DropCreepLoot(dead)
            elseif tag >= TAG_BOSS_ESCORT and tag < TAG_BOSS_ESCORT + 100 then
                call DropCreepLoot(dead)
            endif
        endif
        if tag >= TAG_BOSS and tag < TAG_BOSS + 100 then
            call OnBossDeath(tag - TAG_BOSS, dead)
        endif
        if dead == lich then
            set lichDead = true
            call QuestItemSetCompleted(questLichItem, true)
            call DropRandomItem(ITEM_TYPE_ARTIFACT, 8, GetUnitX(dead), GetUnitY(dead))
            call MsgAll("|cff40ff40Kel'Thuzad has been destroyed!|r")
            call CheckVictory()
        endif
    elseif owner == scourgePlayer then
        if dead == citadel then
            set citadelDead = true
            call QuestItemSetCompleted(questCitadelItem, true)
            call PauseTimer(raidTimer)
            if raidDialog != null then
                call TimerDialogDisplay(raidDialog, false)
            endif
            call MsgAll("|cff40ff40The Black Citadel has been destroyed! No more raids will come.|r")
            call CheckVictory()
        endif
    elseif owner == townPlayer then
        if dead == castle then
            call MsgAll("|cffff4040Brightwater Castle has fallen!|r")
            call Defeat()
        endif
    endif
    set dead = null
    set killer = null
    set owner = null
endfunction

//===========================================================================
// Periodic updates
//===========================================================================

function OnSecond takes nothing returns nothing
    set gameSeconds = gameSeconds + 1
    if gameOver then
        return
    endif
    call CheckOutposts()
    call CheckUrnDelivery()
    if gameSeconds - (gameSeconds / 5) * 5 == 0 then
        call CheckCampRespawns()
    endif
    if gameSeconds - (gameSeconds / 10) * 10 == 0 then
        call PayOutpostIncome()
        call RetargetIdleRaiders()
    endif
    if gameSeconds - (gameSeconds / 90) * 90 == 0 then
        call ReinforceTown()
    endif
    call UpdateBoard()
endfunction

function OnPlayerLeave takes nothing returns nothing
    local integer i = UserIndex(GetTriggerPlayer())
    local integer j = 0
    if i < 0 then
        return
    endif
    set playing[i] = false
    call MsgAll(ColoredName(i) + " has left the game. Their forces now answer to the remaining commanders.")
    loop
        exitwhen j >= USERS
        if playing[j] then
            call SetPlayerAlliance(userPlayer[i], userPlayer[j], ALLIANCE_SHARED_CONTROL, true)
            call SetPlayerAlliance(userPlayer[i], userPlayer[j], ALLIANCE_SHARED_ADVANCED_CONTROL, true)
        endif
        set j = j + 1
    endloop
    call UpdateBoard()
endfunction

function ShowHelp takes nothing returns nothing
    local player p = GetTriggerPlayer()
    call Msg(p, "|cffffcc00Shadows over Brightwater|r")
    call Msg(p, "- Build up your base: peasants, farms, barracks and upgrades work as in a normal game.")
    call Msg(p, "- Creep camps drop items and respawn a few minutes after you clear them.")
    call Msg(p, "- Kill the guards of an outpost and bring a hero next to it to claim it: +15 gold and +5 lumber every 10 seconds.")
    call Msg(p, "- Brightwater sells potions (Goblin Merchant), gear (Armory) and mercenaries.")
    call Msg(p, "- Scourge raids target the castle, your town halls and your outposts. Destroy the Black Citadel and slay Kel'Thuzad to win.")
    call Msg(p, "- Open the quest log (F9) for side quests and rewards.")
    set p = null
endfunction

function Intro1 takes nothing returns nothing
    call MsgAll("|cffffcc00Brightwater|r, the last free town of the vale, calls for heroes.")
    call MsgAll("The Lich |cffb080ffKel'Thuzad|r has raised a Black Citadel in the blighted north. Its first raid comes in a few minutes.")
endfunction

function Intro2 takes nothing returns nothing
    call MsgAll("Build up your base, claim the four outposts for income, and grow your hero on the creeps of the vale.")
    call MsgAll("Type |cffffcc00-help|r at any time for tips. Side quests are in the quest log (F9).")
endfunction

//===========================================================================
// Setup
//===========================================================================

function SetupPlayers takes nothing returns nothing
    local integer i = 0
    local integer j
    set townPlayer = Player(TOWN_ID)
    set scourgePlayer = Player(SCOURGE_ID)
    set creepPlayer = Player(PLAYER_NEUTRAL_AGGRESSIVE)
    set passivePlayer = Player(PLAYER_NEUTRAL_PASSIVE)
    set playerColor[0] = "|cffff0303"
    set playerColor[1] = "|cff0042ff"
    set playerColor[2] = "|cff1ce6b9"
    set playerColor[3] = "|cff8a2be2"
    loop
        exitwhen i >= USERS
        set userPlayer[i] = Player(i)
        set playing[i] = GetPlayerSlotState(userPlayer[i]) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(userPlayer[i]) == MAP_CONTROL_USER
        if playing[i] then
            set playerCount = playerCount + 1
        endif
        set i = i + 1
    endloop
    if playerCount == 0 then
        set playerCount = 1
    endif

    // the defenders, Brightwater included, are allies with shared vision
    set i = 0
    loop
        exitwhen i > TOWN_ID
        set j = 0
        loop
            exitwhen j > TOWN_ID
            if i != j then
                call SetPlayerAllianceStateAllyBJ(Player(i), Player(j), true)
                call SetPlayerAllianceStateVisionBJ(Player(i), Player(j), true)
            endif
            set j = j + 1
        endloop
        set i = i + 1
    endloop
    // the Scourge and the wild creeps leave each other alone
    call SetPlayerAlliance(scourgePlayer, creepPlayer, ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(creepPlayer, scourgePlayer, ALLIANCE_PASSIVE, true)
    call SetPlayerState(scourgePlayer, PLAYER_STATE_GIVES_BOUNTY, 1)
    call SetPlayerColor(scourgePlayer, PLAYER_COLOR_GREEN)
endfunction

function SetupBases takes nothing returns nothing
    local integer i = 0
    local integer k
    local unit mine
    local unit u
    loop
        exitwhen i >= USERS
        set mine = CreateUnit(passivePlayer, 'ngol', baseMineX[i], baseMineY[i], 270.0)
        call SetResourceAmount(mine, 20000)
        if playing[i] then
            call SetPlayerState(userPlayer[i], PLAYER_STATE_RESOURCE_GOLD, 600)
            call SetPlayerState(userPlayer[i], PLAYER_STATE_RESOURCE_LUMBER, 250)
            call SetPlayerTechMaxAllowed(userPlayer[i], 'halt', 0)
            set hall[i] = CreateUnit(userPlayer[i], 'htow', baseHallX[i], baseHallY[i], 270.0)
            set k = 0
            loop
                exitwhen k >= 5
                set u = CreateUnit(userPlayer[i], 'hpea', (baseHallX[i] + baseMineX[i]) / 2.0 + 64.0 * I2R(k - 2), (baseHallY[i] + baseMineY[i]) / 2.0, 270.0)
                call IssueTargetOrder(u, "harvest", mine)
                set k = k + 1
            endloop
            set u = CreateUnit(userPlayer[i], 'hfoo', baseHallX[i] + 320.0, baseHallY[i] + 320.0, 270.0)
            set u = CreateUnit(userPlayer[i], 'hfoo', baseHallX[i] - 320.0, baseHallY[i] + 320.0, 270.0)
            call SetCameraPositionForPlayer(userPlayer[i], baseHallX[i], baseHallY[i])
        endif
        set i = i + 1
    endloop
    set mine = null
    set u = null
endfunction

function SetupTown takes nothing returns nothing
    local integer i = 0
    local unit u
    set townGuards = CreateGroup()
    loop
        exitwhen i >= townStructCount
        if townStructPassive[i] then
            set u = CreateUnit(passivePlayer, townStructType[i], townStructX[i], townStructY[i], 270.0)
        else
            set u = CreateUnit(townPlayer, townStructType[i], townStructX[i], townStructY[i], 270.0)
        endif
        if townStructType[i] == 'hcas' then
            set castle = u
        elseif townStructType[i] == 'nmrk' then
            set armory = u
        endif
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen i >= townGuardCount
        set u = CreateUnit(townPlayer, townGuardType[i], townGuardX[i], townGuardY[i], 90.0)
        call SetUnitUserData(u, TAG_TOWN_GUARD)
        call GroupAddUnit(townGuards, u)
        set i = i + 1
    endloop
    // The Armory is a marketplace with a fixed stock of gear.
    if armory != null then
        call AddItemToStock(armory, 'rat9', 1, 1)
        call AddItemToStock(armory, 'rde2', 1, 1)
        call AddItemToStock(armory, 'rlif', 1, 1)
        call AddItemToStock(armory, 'gcel', 1, 1)
        call AddItemToStock(armory, 'bgst', 1, 1)
        call AddItemToStock(armory, 'belv', 1, 1)
        call AddItemToStock(armory, 'ciri', 1, 1)
        call AddItemToStock(armory, 'rwiz', 1, 1)
        call AddItemToStock(armory, 'ratc', 1, 1)
        call AddItemToStock(armory, 'pghe', 2, 2)
        call AddItemToStock(armory, 'pgma', 2, 2)
    endif
    // Blizzard.j removes every item sold by a neutral shop from its stock
    // (meant for random marketplaces). Keep the Armory's stock instead.
    call DisableTrigger(bj_stockItemPurchased)
    set u = null
endfunction

function SetupScourge takes nothing returns nothing
    local integer i = 0
    local unit u
    local integer bonus = 60 + 20 * playerCount
    loop
        exitwhen i >= scourgeStructCount
        set u = CreateUnit(scourgePlayer, scourgeStructType[i], scourgeStructX[i], scourgeStructY[i], 270.0)
        if scourgeStructType[i] == 'unp2' then
            set citadel = u
        endif
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen i >= scourgeGuardCount
        set u = CreateUnit(scourgePlayer, scourgeGuardType[i], scourgeGuardX[i], scourgeGuardY[i], 270.0)
        set i = i + 1
    endloop
    set lich = CreateUnit(creepPlayer, 'Uktl', lichX, lichY, 270.0)
    call SetHeroLevel(lich, 10, false)
    call SelectHeroSkill(lich, 'AUfn')
    call SelectHeroSkill(lich, 'AUfu')
    call SelectHeroSkill(lich, 'AUdr')
    call SelectHeroSkill(lich, 'AUfn')
    call SelectHeroSkill(lich, 'AUfu')
    call SelectHeroSkill(lich, 'AUdd')
    call SelectHeroSkill(lich, 'AUfn')
    call SelectHeroSkill(lich, 'AUfu')
    call SelectHeroSkill(lich, 'AUdr')
    call SelectHeroSkill(lich, 'AUdr')
    call SetHeroStr(lich, GetHeroStr(lich, false) + bonus, true)
    call SetHeroInt(lich, GetHeroInt(lich, false) + 30, true)
    call UnitAddItemById(lich, 'rde3')
    call SetWidgetLife(lich, GetUnitState(lich, UNIT_STATE_MAX_LIFE))
    set i = 0
    loop
        exitwhen i >= outpostCount
        set outpostOwner[i] = -1
        if outpostStartsScourge[i] then
            call SetOutpostOwner(i, SCOURGE_ID)
        endif
        set i = i + 1
    endloop
    set u = null
endfunction

function SetupCreeps takes nothing returns nothing
    local integer i = 0
    loop
        exitwhen i >= campCount
        call SpawnCamp(i)
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen i >= bossCount
        call SpawnBoss(i)
        set i = i + 1
    endloop
endfunction

function SetupTriggers takes nothing returns nothing
    local trigger t = CreateTrigger()
    local integer i = 0
    loop
        exitwhen i >= bj_MAX_PLAYER_SLOTS
        call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_DEATH, null)
        set i = i + 1
    endloop
    call TriggerAddAction(t, function OnUnitDeath)

    set t = CreateTrigger()
    set i = 0
    loop
        exitwhen i >= USERS
        call TriggerRegisterPlayerEvent(t, userPlayer[i], EVENT_PLAYER_LEAVE)
        set i = i + 1
    endloop
    call TriggerAddAction(t, function OnPlayerLeave)

    set t = CreateTrigger()
    set i = 0
    loop
        exitwhen i >= USERS
        call TriggerRegisterPlayerChatEvent(t, userPlayer[i], "-help", true)
        set i = i + 1
    endloop
    call TriggerAddAction(t, function ShowHelp)
    set t = null
endfunction

function StartGameTimers takes nothing returns nothing
    call TimerStart(CreateTimer(), 1.0, true, function OnSecond)
    set raidTimer = CreateTimer()
    call TimerStart(raidTimer, 360.0, false, function LaunchRaid)
    call TimerStart(CreateTimer(), 0.5, false, function ShowHeroDialog)
    call TimerStart(CreateTimer(), 1.0, false, function CreateBoard)
    call TimerStart(CreateTimer(), 2.0, false, function Intro1)
    call TimerStart(CreateTimer(), 12.0, false, function Intro2)
    call TimerStart(CreateTimer(), 45.0, false, function ForceHeroPick)
endfunction

function InitGame takes nothing returns nothing
    set tempGroup = CreateGroup()
    set raiders = CreateGroup()
    call InitLayout()
    call SetupPlayers()
    call ExecuteFunc("SetupBases")
    call ExecuteFunc("SetupTown")
    call ExecuteFunc("SetupScourge")
    call ExecuteFunc("SetupCreeps")
    call CreateQuests()
    call InitHeroChoices()
    call SetupTriggers()
    call StartGameTimers()
endfunction

//#CONFIG
